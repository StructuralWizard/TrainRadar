<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup (Google Drive and device-to-device): the user's own
     data (favourites and settings in shared preferences; databases from
     phase C5) only. The WebView's caches and the bundled data are left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
