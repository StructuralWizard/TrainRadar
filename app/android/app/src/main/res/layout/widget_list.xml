<?xml version="1.0" encoding="utf-8"?>
<!-- TrainRadar Pro widgets (departures, arrivals, one train, notices):
     a title, a refresh button, when it was updated, and up to six rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="TrainRadar"
            android:textColor="#1D4ED8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_refresh"
            android:gravity="center"
            android:text="↻"
            android:textColor="#1D4ED8"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#6B7280"
        android:textSize="11sp" />

    <TextView android:id="@+id/w_row0" style="@style/WidgetListRow" />
    <TextView android:id="@+id/w_row1" style="@style/WidgetListRow" />
    <TextView android:id="@+id/w_row2" style="@style/WidgetListRow" />
    <TextView android:id="@+id/w_row3" style="@style/WidgetListRow" />
    <TextView android:id="@+id/w_row4" style="@style/WidgetListRow" />
    <TextView android:id="@+id/w_row5" style="@style/WidgetListRow" />
</LinearLayout>
